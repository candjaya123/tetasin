CREATE INDEX idx_sales_orders_tenant_status ON public.sales_orders(tenant_id, status);
CREATE INDEX idx_sales_orders_tenant_created_at ON public.sales_orders(tenant_id, created_at DESC);

CREATE TABLE IF NOT EXISTS public.transactions (
