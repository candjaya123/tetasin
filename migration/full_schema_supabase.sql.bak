    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE INDEX idx_product_variants_product ON public.product_variants(product_id);
CREATE INDEX idx_product_variants_tenant ON public.product_variants(tenant_id);

-- 7. Accounting 
CREATE TABLE IF NOT EXISTS public.journal_entries (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    tenant_id UUID NOT NULL REFERENCES public.tenants(id) ON DELETE CASCADE,
    transaction_date TIMESTAMPTZ DEFAULT NOW(),
    description TEXT NOT NULL,
    reference_type TEXT,
    reference_id UUID,
    status journal_status DEFAULT 'posted',
    created_by UUID REFERENCES public.profiles(id) ON DELETE SET NULL,
    idempotency_key TEXT UNIQUE,
    total_amount NUMERIC(15,2) DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

ALTER TABLE public.journal_entries ADD COLUMN IF NOT EXISTS reference_doc TEXT;

CREATE INDEX idx_journal_entries_tenant_date ON public.journal_entries(tenant_id, transaction_date DESC);
CREATE INDEX idx_journal_entries_tenant_ref_type ON public.journal_entries(tenant_id, reference_type);
CREATE INDEX idx_journal_entries_ref_id ON public.journal_entries(reference_id);

CREATE TABLE IF NOT EXISTS public.journal_lines (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    journal_entry_id UUID NOT NULL REFERENCES public.journal_entries(id) ON DELETE CASCADE,
    entry_id UUID REFERENCES public.journal_entries(id) ON DELETE CASCADE, -- legacy alias for backward compat
    tenant_id UUID NOT NULL REFERENCES public.tenants(id) ON DELETE CASCADE,
    account_id UUID NOT NULL REFERENCES public.chart_of_accounts(id) ON DELETE RESTRICT,
    debit NUMERIC(15,2) DEFAULT 0,
    credit NUMERIC(15,2) DEFAULT 0,
    description TEXT,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE INDEX idx_journal_lines_journal_entry_id ON public.journal_lines(journal_entry_id);
CREATE INDEX idx_journal_lines_entry_id ON public.journal_lines(entry_id);
CREATE INDEX idx_journal_lines_account_id ON public.journal_lines(account_id);

-- Note: journal_lines uses debit/credit NUMERIC columns (not type/amount)
-- This matches the existing codebase pattern established in tahap_2 migration.
-- The type/amount pattern was considered in ADR process but debit/credit was kept
-- for backward compatibility with all existing accounting views and functions.

